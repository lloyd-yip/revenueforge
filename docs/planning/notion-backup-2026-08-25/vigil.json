  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Every founder who buys a revenue dashboard eventually stops looking at it. Dashboards require the user to come to the data. Vigil brings the data to the user. This transforms the retainer from \u201cwe maintain your system\u201d into \u201cwe have someone watching your revenue 24/7.\u201d That is a fundamentally different product category \u2014 and the emotional center of every sales conversation.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Every founder who buys a revenue dashboard eventually stops looking at it. Dashboards require the user to come to the data. Vigil brings the data to the user. This transforms the retainer from \u201cwe maintain your system\u201d into \u201cwe have someone watching your revenue 24/7.\u201d That is a fundamentally different product category \u2014 and the emotional center of every sales conversation.",
